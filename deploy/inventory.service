[Unit]
Description=Daily Processing Inventory Flask App
After=network.target postgresql.service

[Service]
User=inventory
Group=inventory
WorkingDirectory=/opt/inventory-app/app
EnvironmentFile=/etc/inventory-app/inventory.env
ExecStart=/opt/inventory-app/app/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
