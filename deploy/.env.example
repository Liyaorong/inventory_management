# Copy this file to /etc/inventory-app/inventory.env on the server.
# Generate a strong secret with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=replace-with-a-strong-random-secret
DATABASE_URL=postgresql+psycopg://inventory_user:replace-with-db-password@127.0.0.1:5432/inventory_db
AUTO_CREATE_DB=0
FLASK_DEBUG=0
